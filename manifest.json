{
  "manifest_version": 3,
  "name": "Canvas Assignment Helper",
  "version": "1.0.0",
  "description": "Extracts Canvas assignment questions and gets answers from Claude AI.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.canvas.com/courses/*/assignments/*",
        "https://*.canvas.com/courses/*/quizzes/*"
      ],
      "js": ["content.js"],
      "css": ["sidebar.css"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Canvas Assignment Helper"
  }
}
